  m_Name: DiscoveryCatalog
  m_EditorClassIdentifier: Assembly-CSharp::DiscoveryCatalog
  itemDatabase: {fileID: 11400000, guid: 979bc07c69fc017448bf2f72ef9a97df, type: 2}
  enemies:
  - id: WorkerAnt
    displayName: "Formiga oper\xE1ria"
    description: "Persegue voc\xEA e morde. Ela recua o corpo antes da mordida, ent\xE3o d\xE1 para desviar."
    icon: {fileID: 21300000, guid: 0b9b5c1d489c4743948035ba2d7b4b86, type: 3}
    isBoss: 0
  - id: SoldierAnt
    displayName: Formiga-soldado
    description: Lenta e cheia de vida. Empina e fica vermelha antes de uma mordida forte que empurra.
    icon: {fileID: 21300000, guid: e09403a40b864e7ab53e3e9aa1c9aae0, type: 3}
    isBoss: 0
  - id: Termite
    displayName: Cupim
    description: "Sai do ch\xE3o em grupos, no meio de uma nuvem de terra, e corre para morder."
    icon: {fileID: 21300000, guid: 16b90d7f3ad342579bc6589e9ecf4f69, type: 3}
    isBoss: 0
  - id: Aphid
    displayName: "Pulg\xE3o"
    description: "Inofensivo. Foge quando voc\xEA chega perto e solta muitas migalhas ao morrer."
    icon: {fileID: 21300000, guid: 07be7aad629b47e1b19a7f63ce105a45, type: 3}
    isBoss: 0
  - id: BombardierBeetle
    displayName: Besouro-bombardeiro
    description: "Fica longe e atira \xE1cido em arco. Vira de costas e a ponta do abd\xF4men brilha antes de disparar."
    icon: {fileID: 21300000, guid: 281d41f464374b1dac4f9c6a105e9b3d, type: 3}
    isBoss: 0
  - id: Spider
    displayName: Aranha
    description: "Agacha e pula em cima de voc\xEA (o c\xEDrculo vermelho marca onde cai) e cospe teia que prende."
    icon: {fileID: 21300000, guid: a3c3fd241ea6455fa052f25c4e480dd3, type: 3}
    isBoss: 0
  - id: MantisBoss
    displayName: Louva-a-deus
    description: O chefe. Garras, investida e pulo esmagador, sempre com aviso vermelho. Fica furioso com metade da vida.
    icon: {fileID: 21300000, guid: 7b03585a06f94221be39d6c4e1cff4ab, type: 3}
    isBoss: 1
  - id: SpiderQueen
    displayName: Aranha-rainha
    description: "Chefe. Cospe leques de teia que prendem, invoca aranhinhas e esmaga com pulos (o c\xEDrculo vermelho marca onde cai)."
    icon: {fileID: 21300000, guid: bb7c7baaedcce434b9bad2335b7d318e, type: 3}
    isBoss: 1
