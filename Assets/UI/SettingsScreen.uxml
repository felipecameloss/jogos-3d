<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menus.uss" />
    <ui:VisualElement name="root" class="screen overlay hidden">
        <ui:VisualElement class="panel settings-panel">
            <ui:Label text="Configurações" class="heading" />

            <ui:Label text="Controles" class="settings-section" />
            <ui:VisualElement class="settings-row">
                <ui:Label text="Sensibilidade da câmera" class="settings-label" />
                <ui:Slider name="sensitivity" low-value="0.25" high-value="8" class="settings-slider" />
                <ui:Label name="sensitivity-value" text="2.5" class="settings-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="Inverter eixo Y" class="settings-label" />
                <ui:Toggle name="invert-y" class="settings-toggle" />
            </ui:VisualElement>

            <ui:Label text="Vídeo" class="settings-section" />
            <ui:VisualElement class="settings-row">
                <ui:Label text="Campo de visão" class="settings-label" />
                <ui:Slider name="fov" low-value="50" high-value="100" class="settings-slider" />
                <ui:Label name="fov-value" text="60" class="settings-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="Tela cheia" class="settings-label" />
                <ui:Toggle name="fullscreen" class="settings-toggle" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="Tremida de tela" class="settings-label" />
                <ui:Slider name="shake" low-value="0" high-value="1.5" class="settings-slider" />
                <ui:Label name="shake-value" text="100%" class="settings-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="Números de dano" class="settings-label" />
                <ui:Toggle name="damage-numbers" class="settings-toggle" />
            </ui:VisualElement>

            <ui:Label text="Áudio" class="settings-section" />
            <ui:VisualElement class="settings-row">
                <ui:Label text="Volume geral" class="settings-label" />
                <ui:Slider name="master" low-value="0" high-value="1" class="settings-slider" />
                <ui:Label name="master-value" text="100%" class="settings-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="Música" class="settings-label" />
                <ui:Slider name="music" low-value="0" high-value="1" class="settings-slider" />
                <ui:Label name="music-value" text="70%" class="settings-value" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="Efeitos" class="settings-label" />
                <ui:Slider name="sfx" low-value="0" high-value="1" class="settings-slider" />
                <ui:Label name="sfx-value" text="80%" class="settings-value" />
            </ui:VisualElement>

            <ui:VisualElement class="settings-buttons">
                <ui:Button name="reset" text="Restaurar padrão" class="btn btn--secondary settings-button" />
                <ui:Button name="back" text="Voltar" class="btn settings-button" />
            </ui:VisualElement>
            <ui:Label text="Esc para voltar" class="hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
