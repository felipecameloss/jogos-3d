<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menus.uss" />
    <ui:VisualElement name="root" class="screen overlay hidden">
        <ui:VisualElement class="panel">
            <ui:Label name="heading" text="Você foi esmagado" class="heading heading--death" />
            <ui:VisualElement class="stats">
                <ui:VisualElement class="stat-row"><ui:Label text="Tempo" class="stat-label" /><ui:Label name="time" text="0:00" class="stat-value" /></ui:VisualElement>
                <ui:VisualElement class="stat-row"><ui:Label text="Dificuldade" class="stat-label" /><ui:Label name="difficulty" text="Fácil" class="stat-value" /></ui:VisualElement>
                <ui:VisualElement class="stat-row"><ui:Label text="Inimigos derrotados" class="stat-label" /><ui:Label name="kills" text="0" class="stat-value" /></ui:VisualElement>
                <ui:VisualElement class="stat-row"><ui:Label text="Migalhas juntadas" class="stat-label" /><ui:Label name="crumbs" text="0" class="stat-value" /></ui:VisualElement>
                <ui:VisualElement class="stat-row"><ui:Label text="Itens" class="stat-label" /><ui:Label name="items" text="0" class="stat-value" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="restart" text="Jogar de novo" class="btn" />
            <ui:Button name="main-menu" text="Menu principal" class="btn btn--secondary" />
            <ui:Label text="R para jogar de novo" class="hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
