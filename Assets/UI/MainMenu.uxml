<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menus.uss" />
    <ui:VisualElement name="root" class="screen menu-bg">
        <ui:VisualElement class="panel">
            <!-- Nome provisório: troque aqui quando o jogo tiver nome -->
            <ui:Label name="title" text="ENCOLHIDOS" class="title" />
            <ui:Label text="um roguelike no quintal" class="subtitle" />
            <ui:Button name="play" text="Jogar" class="btn" />
            <ui:Button name="controls-toggle" text="Controles" class="btn btn--secondary" />
            <ui:VisualElement name="controls" class="controls hidden">
                <ui:VisualElement class="controls-row"><ui:Label text="W A S D" class="key" /><ui:Label text="andar" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="Shift" class="key" /><ui:Label text="correr" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="Espaço" class="key" /><ui:Label text="pular" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="Mouse" class="key" /><ui:Label text="mirar" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="Botão esquerdo" class="key" /><ui:Label text="atirar (segurar)" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="Botão direito" class="key" /><ui:Label text="agulha" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="Q" class="key" /><ui:Label text="dash" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="R" class="key" /><ui:Label text="formigas aliadas" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="E" class="key" /><ui:Label text="abrir / interagir" class="action" /></ui:VisualElement>
                <ui:VisualElement class="controls-row"><ui:Label text="Esc" class="key" /><ui:Label text="pausar" class="action" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="quit" text="Sair" class="btn btn--secondary" />
            <ui:Label text="Enter para jogar" class="hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
