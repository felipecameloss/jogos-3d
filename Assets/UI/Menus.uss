/* Estilo compartilhado dos menus (principal, pause, fim de run) */

.screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.menu-bg {
    background-color: rgb(16, 26, 15);
    background-image: none;
}

.overlay {
    background-color: rgba(6, 10, 5, 0.78);
}

.hidden {
    display: none;
}

.panel {
    background-color: rgba(20, 25, 17, 0.96);
    border-radius: 22px;
    border-width: 2px;
    border-color: rgb(138, 174, 76);
    padding: 28px 54px 24px 54px;
    min-width: 450px;
    align-items: stretch;
}

.title {
    font-size: 62px;
    color: rgb(248, 228, 162);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0px 4px 10px rgba(0, 0, 0, 0.75);
    letter-spacing: 3px;
    margin-bottom: 2px;
}

.subtitle {
    font-size: 20px;
    color: rgb(176, 204, 142);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.heading {
    font-size: 46px;
    color: rgb(248, 228, 162);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0px 3px 8px rgba(0, 0, 0, 0.75);
    margin-bottom: 22px;
}

.heading--death {
    color: rgb(240, 112, 88);
}

.btn {
    height: 50px;
    margin: 5px 0;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.55);
    background-color: rgb(94, 134, 48);
    border-width: 1px;
    border-color: rgba(188, 226, 120, 0.45);
    border-radius: 12px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.08s;
}

.btn:hover {
    background-color: rgb(118, 164, 62);
    border-color: rgb(244, 226, 166);
    scale: 1.03 1.03;
}

.btn:active {
    background-color: rgb(70, 96, 38);
    scale: 0.98 0.98;
}

.btn:focus {
    border-width: 2px;
    border-color: rgb(244, 226, 166);
}

.btn--secondary {
    background-color: rgb(48, 56, 42);
    border-color: rgba(150, 170, 130, 0.28);
}

.btn--secondary:hover {
    background-color: rgb(70, 80, 60);
    border-color: rgb(190, 214, 156);
}

.stats {
    margin-bottom: 22px;
    padding: 14px 18px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 12px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin: 5px 0;
}

.stat-label {
    font-size: 21px;
    color: rgb(178, 188, 158);
}

.stat-value {
    font-size: 21px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.hint {
    font-size: 15px;
    color: rgb(146, 158, 126);
    -unity-text-align: middle-center;
    margin-top: 16px;
}

.controls {
    margin: 4px 0 10px 0;
    padding: 12px 18px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 12px;
}

.controls-row {
    flex-direction: row;
    justify-content: space-between;
    margin: 1px 0;
}

.key {
    font-size: 15px;
    color: rgb(244, 226, 166);
    -unity-font-style: bold;
}

.action {
    font-size: 15px;
    color: rgb(210, 216, 196);
}

/* ---------- Configurações ---------- */

.settings-panel {
    width: 700px;
    background-color: rgb(26, 30, 22); /* opaco: o menu de baixo não aparece através */
    padding: 26px 40px 20px 40px;
}

.settings-section {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(176, 198, 142);
    margin: 10px 0 2px 0;
    border-bottom-width: 1px;
    border-color: rgba(176, 198, 142, 0.35);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
}

.settings-label {
    width: 240px;
    font-size: 18px;
    color: rgb(232, 236, 222);
}

.settings-slider {
    flex-grow: 1;
    margin: 0 12px 0 0;
}

.settings-value {
    width: 60px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(244, 226, 166);
    -unity-text-align: middle-right;
}

/* Trilho e botão do slider (o tema padrão fica escuro no painel escuro) */
.settings-slider .unity-base-slider__tracker {
    background-color: rgb(58, 64, 50);
    border-color: rgb(58, 64, 50);
    height: 6px;
    margin-top: -3px;
    border-radius: 3px;
}

.settings-slider .unity-base-slider__dragger {
    background-color: rgb(244, 226, 166);
    border-color: rgb(118, 148, 66);
    width: 18px; height: 18px;
    margin-top: -9px;
    border-radius: 9px;
}

.settings-slider .unity-base-slider__dragger-border {
    display: none;
}

.settings-toggle .unity-toggle__checkmark {
    width: 24px; height: 24px;
    background-color: rgb(58, 64, 50);
    border-color: rgb(118, 148, 66);
    border-width: 2px;
    border-radius: 5px;
    -unity-background-image-tint-color: rgb(244, 226, 166);
}

.settings-buttons {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
}

.settings-button {
    width: 300px;
}
