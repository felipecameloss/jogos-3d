/* HUD de jogo. Referência 1600x900 (PanelSettings escala o resto). */

.hud {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.hidden { display: none; }

/* Três anéis aninhados, cada um mais transparente: imita um degradê das bordas para o centro */
.damage-flash {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 26px;
    border-color: rgba(220, 30, 20, 0.75);
    opacity: 0;
}

.damage-ring {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    border-width: 26px;
}

.damage-ring--2 { border-color: rgba(220, 30, 20, 0.4); }
.damage-ring--3 { border-color: rgba(220, 30, 20, 0.15); }

/* ---------- Canto superior esquerdo ---------- */

.top-left {
    position: absolute;
    left: 24px; top: 22px;
    width: 420px;
}

.health-bar {
    height: 30px;
    background-color: rgba(10, 14, 8, 0.75);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.6);
    overflow: hidden;
}

.health-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
    background-color: rgb(110, 196, 70);
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.health-fill--low {
    background-color: rgb(222, 70, 52);
}

.shield-fill {
    position: absolute;
    left: 0; bottom: 0;
    height: 6px;
    width: 0%;
    background-color: rgb(90, 205, 255);
    transition-property: width;
    transition-duration: 0.12s;
}

.health-text {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-text-align: middle-center;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
}

.crumbs {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.crumb-icon {
    width: 18px; height: 14px;
    background-color: rgb(238, 190, 108);
    border-radius: 4px;
    rotate: -12deg;
    margin-right: 8px;
}

.crumbs-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(250, 226, 160);
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
}

.items {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.item-slot {
    width: 44px; height: 44px;
    margin: 0 6px 6px 0;
    border-radius: 8px;
    border-width: 2px;
    background-color: rgba(10, 14, 8, 0.75);
    align-items: center;
    justify-content: center;
}

.item-abbr {
    font-size: 16px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.item-count {
    position: absolute;
    right: -7px; bottom: -7px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 6px;
    padding: 0 4px;
}

/* ---------- Canto superior direito ---------- */

.top-right {
    position: absolute;
    right: 24px; top: 18px;
    width: 220px;
    align-items: flex-end;
}

.timer {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.7);
}

.difficulty {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(250, 226, 160);
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
}

.difficulty-bar {
    width: 220px; height: 8px;
    margin-top: 5px;
    background-color: rgba(10, 14, 8, 0.75);
    border-radius: 4px;
    overflow: hidden;
}

.difficulty-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(250, 190, 70);
}

.stage {
    font-size: 15px;
    color: rgb(200, 210, 186);
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
}

/* ---------- Objetivo ---------- */

.objective {
    position: absolute;
    left: 0; right: 0; top: 20px;
    align-items: center;
}

.objective-text {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(10, 14, 8, 0.6);
    border-radius: 8px;
    padding: 4px 14px;
}

.objective-text--warning {
    color: rgb(255, 130, 105);
}

.objective-bar {
    width: 320px; height: 10px;
    margin-top: 6px;
    background-color: rgba(10, 14, 8, 0.75);
    border-radius: 5px;
    overflow: hidden;
}

.objective-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(140, 220, 90);
}

.boss {
    margin-top: 10px;
    align-items: center;
}

.boss-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.8);
}

.boss-name--enraged {
    color: rgb(255, 110, 80);
}

.boss-bar {
    width: 560px; height: 16px;
    margin-top: 3px;
    background-color: rgba(10, 14, 8, 0.8);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.7);
    overflow: hidden;
}

.boss-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(205, 52, 40);
    transition-property: width;
    transition-duration: 0.15s;
}

/* ---------- Mira ---------- */

.crosshair {
    position: absolute;
    left: 50%; top: 50%;
    width: 0; height: 0;
}

.cross {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.9);
}

.cross--h-left  { left: -11px; top: -1px; width: 7px; height: 2px; }
.cross--h-right { left: 4px;   top: -1px; width: 7px; height: 2px; }
.cross--v-top    { left: -1px; top: -11px; width: 2px; height: 7px; }
.cross--v-bottom { left: -1px; top: 4px;   width: 2px; height: 7px; }

/* ---------- Popup de item ---------- */

.popup {
    position: absolute;
    left: 0; right: 0;
    top: 17%;
    align-items: center;
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.popup--hidden {
    opacity: 0;
    translate: 0 12px;
}

.popup-name {
    font-size: 30px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.8);
}

.popup-desc {
    font-size: 19px;
    color: rgb(232, 236, 222);
    text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.8);
}

/* ---------- Embaixo ---------- */

.bottom {
    position: absolute;
    left: 0; right: 0; bottom: 22px;
    align-items: center;
}

.prompt {
    font-size: 20px;
    color: rgb(255, 238, 180);
    background-color: rgba(10, 14, 8, 0.78);
    border-radius: 10px;
    padding: 8px 18px;
    margin-bottom: 14px;
}

.prompt--unavailable {
    color: rgb(255, 120, 105);
}

.abilities {
    flex-direction: row;
}

.ability {
    width: 72px; height: 66px;
    margin: 0 6px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.6);
    background-color: rgba(10, 14, 8, 0.8);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.ability-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 12px;
}

.ability-key {
    position: absolute;
    left: 3px; top: 1px;
    font-size: 11px;
    color: rgb(250, 226, 160);
    -unity-font-style: bold;
}

.ability-cooldown {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 0%;
    background-color: rgba(0, 0, 0, 0.7);
}

.ability-cooldown-text {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
